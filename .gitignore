node_modules/
dist/
.env
*.local
.DS_Store
npm-debug.log*

# Dev-only JWT signing keypair (backend/keys/) — never belongs in git, even
# for a throwaway local-dev key. Anyone cloning the repo generates their own.
*.pem
backend/keys/

# Extracted scratch text from the source .docx files — regenerate from the
# .docx if needed, don't hand-edit.
UOS_extracted.txt

# Docs and planning files — kept local only, not pushed to this repo.
# The root README.md is the one exception — it's what shows up on the
# GitHub repo page. The leading slash anchors this to the root only, so
# any other README.md deeper in the tree (e.g. inside the vendored
# uos-module-developer-bundle/ reference template) stays excluded too.
*.md
*.docx
!/README.md

# Handover bundles are generated, never committed — a copy in the repo is a
# second source of truth that goes stale the day the platform moves.
uos-module-developer-bundle/
uos-module-developer-bundle.zip
