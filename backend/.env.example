# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Module identity ─────────────────────────────────────────────────────────
MODULE_NAME=hostel
# UUID from the auth server's `modules` table — ask the auth-server team to
# register this module and hand you this ID. Scoped tokens issued for any
# other module are rejected with 403. In standalone dev mode this can be any
# fixed placeholder value (e.g. 'dev-hostel') — nothing validates it against a
# real registry until you connect to the live platform.
MODULE_ID=dev-hostel
# Postgres schema this module owns inside every tenant database.
MODULE_SCHEMA=hostel

# ─── Standalone dev mode ──────────────────────────────────────────────────────
# Set to true to develop against a single local Postgres with a self-signed
# token instead of the real platform — no live auth-server, no tenant catalog,
# no outbox sync needed. Real code paths (requireAuth, scopedRequest, getTrx)
# run completely unmodified; this only swaps which tenant config feeds them.
# NEVER set true with NODE_ENV=production — the app refuses to boot if it is.
# See README "Standalone dev mode" for the full walkthrough.
DEV_STANDALONE=true
# Must be a real UUID shape — org_id flows into uuid-typed columns downstream
# (e.g. permission/audit tables), a plain string like "dev-org" breaks with a
# Postgres "invalid input syntax for type uuid" error. This is the only
# "tenant" that exists in standalone mode. Must match dev:mint-token's org_id.
DEV_ORG_ID=00000000-0000-0000-0000-000000000000
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=hostel_dev

# ─── Auth server (live platform mode only) ───────────────────────────────────
# Base URL of uos-auth-server. Used for the tenant catalog and sync polling.
# Not required when DEV_STANDALONE=true.
AUTH_SERVER_URL=http://localhost:4000
# Path to the RS256 public key. Live mode: distributed by uos-auth-server —
# never use the private key in a module, only the auth server has that.
# Standalone mode: your own throwaway keypair from `npm run keys:generate`
# (./keys/dev-public.pem, paired with dev-private.pem for dev:mint-token).
AUTH_PUBLIC_KEY_PATH=./keys/dev-public.pem
# Shared secret for /sync/* and /internal/* — must match the auth server's
# INTERNAL_SYNC_SECRET exactly. Not required when DEV_STANDALONE=true.
INTERNAL_SYNC_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
# Cluster-wide roles for this module. Live mode: the SAME credential works
# against every tenant database this module is entitled to, ask the
# auth-server team to bootstrap hostel_app/hostel_admin on the shared cluster.
# Standalone mode: create these two roles yourself on your own local Postgres
# (see README — `CREATE ROLE hostel_app WITH LOGIN PASSWORD '...';` — no
# BYPASSRLS on the app role, assertRlsRole checks for that on every boot).
DB_APP_USER=hostel_app
DB_APP_PASSWORD=hostel_app_dev_password
DB_ADMIN_USER=hostel_admin
DB_ADMIN_PASSWORD=hostel_admin_dev_password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Local dev only ───────────────────────────────────────────────────────────
# Used only by knexfile.ts for the Knex CLI (migrate:make, ad-hoc migrate:latest
# against one dev tenant). Runtime migrations go through registry.migrateAll()
# instead — see src/index.ts. In standalone mode this points at the same DB as
# DEV_DB_HOST/PORT/NAME above.
LOCAL_DEV_DATABASE_URL=postgresql://hostel_admin:hostel_admin_dev_password@localhost:5432/hostel_dev
