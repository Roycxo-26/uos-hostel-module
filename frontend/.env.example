# Backend now lives at its own origin/port (see backend/.env.example PORT,
# default 3001) rather than being reverse-proxied under /api — CORS is open
# on the backend (app.use(cors()) in src/app.ts) so a direct cross-origin
# fetch works without a dev proxy.
#
# Copy this file to frontend/.env before running the UI. There is no committed
# default and no fallback in the code, so leaving it unset means every API call
# goes nowhere with no obvious cause.
#
# Must match backend/.env PORT. If you moved that to avoid a clash with another
# module, move this too.
VITE_API_BASE_URL=http://localhost:3001
