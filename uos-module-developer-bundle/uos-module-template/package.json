{
  "name": "uos-module-template",
  "version": "1.0.0",
  "description": "Starter template for UOS backend modules",
  "main": "dist/index.js",
  "scripts": {
    "start": "nodemon",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --fix",
    "migrate:make": "npx knex migrate:make --knexfile src/database/knexfile.ts -x ts",
    "migrate:latest": "npx knex migrate:latest --knexfile src/database/knexfile.ts",
    "migrate:rollback": "npx knex migrate:rollback --knexfile src/database/knexfile.ts",
    "migrate:up": "npx knex migrate:up --knexfile src/database/knexfile.ts",
    "migrate:down": "npx knex migrate:down --knexfile src/database/knexfile.ts",
    "migrate:list": "npx knex migrate:list --knexfile src/database/knexfile.ts",
    "seed:make": "npx knex seed:make --knexfile src/database/knexfile.ts",
    "seed:up": "npx knex seed:run --knexfile src/database/knexfile.ts",
    "keys:generate": "node scripts/dev-generate-keys.js",
    "dev:mint-token": "ts-node scripts/dev-mint-token.ts",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "dependencies": {
    "@uos/auth": "github:SuperCXO/uos-auth-package#feat/two-token-flow",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "nodemon": "^3.1.0",
    "pinst": "^3.0.0",
    "prettier": "^3.0.0",
    "pretty-quick": "^4.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0"
  }
}
